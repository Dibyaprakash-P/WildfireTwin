# WildfireTwin environment configuration — copy to .env and fill in.
# Never commit .env. Generate a local development file with:  python -m scripts.init_env

# --- core ---------------------------------------------------------------
APP_ENV=development                 # development | production | test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=                         # REQUIRED in production: long random string (e.g. 64+ chars)
JWT_EXPIRE_MINUTES=120

# --- database -----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wildfiretwin

# --- email OTP ----------------------------------------------------------
# console = development only: the OTP is printed to the backend console (stdout).
EMAIL_PROVIDER=console              # console | smtp | resend | sendgrid
EMAIL_FROM=WildfireTwin <no-reply@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESEND_API_KEY=
SENDGRID_API_KEY=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Google Sign-In (OAuth 2.0 / OpenID Connect) ------------------------
# Create an OAuth client (type: Web) in Google Cloud Console; add the frontend
# origin to "Authorized JavaScript origins". Only the client ID is needed.
GOOGLE_CLIENT_ID=

# --- NASA FIRMS ---------------------------------------------------------
# Optional. Without a MAP_KEY the app uses the local NRT files in datasets/.
# Request a key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_API_SOURCE=VIIRS_NOAA20_NRT
FIRMS_API_DAYS=2
FIRMS_ACTIVE_HOURS=48

# --- weather ------------------------------------------------------------
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_SECONDS=900

# --- dynamic monitoring -------------------------------------------------
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=900

# --- inference ----------------------------------------------------------
DEFAULT_MODEL=physics_fno           # physics_fno | fno | unet
INFERENCE_DEVICE=auto               # auto | cpu | cuda

# --- frontend (Vite reads VITE_* from frontend/.env) --------------------
# VITE_API_URL=http://127.0.0.1:8000
# VITE_CESIUM_ION_TOKEN=            # optional: enables Cesium World Terrain / Bing imagery
# The globe is CesiumJS: no Mapbox token is needed. The wind-flow layer uses NOAA GFS via the backend (no key).
